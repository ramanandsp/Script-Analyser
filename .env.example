# ============================================================
# SCRIPT ANALYSER PRO — ENVIRONMENT CONFIGURATION TEMPLATE
# ============================================================

# 1. Supabase PostgreSQL Database (Production Cloud)
# Format: postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres
# Leave blank to use local SQLite database (script_analyser.db)
DATABASE_URL=

# SQLite database file path (used only when DATABASE_URL is not set)
DATABASE_PATH=script_analyser.db

# 2. Supabase Authentication
# Found in: Supabase Dashboard -> Project Settings -> API
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-supabase-publishable-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-secret-key
SUPABASE_JWT_SECRET=your-supabase-jwt-secret

# 3. Application Security & Local Auth Fallback
# Generate any random 32+ character string for JWT session tokens
SECRET_KEY=generate-a-secure-random-secret-key-for-sessions

# 4. University Faculty Demonstration Credentials
# Pre-configured fast demo access account for presentations
DEMO_USER_EMAIL=faculty@scriptanalyser.com
DEMO_USER_PASSWORD=FacultyDemo2026!

# 5. OMDb API Configuration (Movie metadata & market intelligence)
# Free API Key available at: https://www.omdbapi.com/apikey.aspx
# Kept strictly server-side; never exposed to browser client
OMDB_API_KEY=your_omdb_key_here

# 6. Application Branding & Author
APP_AUTHOR=Ramanand S P

# 7. Deployment & Network Configuration
# Allowed CORS origins (comma-separated, or * for all)
CORS_ORIGINS=*
PORT=8000

# 8. OpenStreetMap GIS Geocoding
GEOCODING_USER_AGENT=ScriptAnalyserPro/2.1 (contact: ramanand@example.com)
